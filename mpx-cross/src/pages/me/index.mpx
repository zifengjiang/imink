<template>
  <view class="card">
    <view class="title">我的（MePage.swift）</view>
    <view>当前用户：{{user.username || '未登录'}}</view>
    <button @tap="goLogin">重新登录</button>
  </view>
</template>
<script>
  import { profile } from '../../api/auth'
  import { clearToken } from '../../utils/storage'

  export default {
    data: { user: {} },
    async onShow() {
      try {
        const data = await profile()
        this.user = data.user || {}
      } catch (e) {
        this.user = {}
      }
    },
    methods: {
      goLogin() {
        clearToken()
        mpx.navigateTo({ url: '/pages/login/index' })
      }
    }
  }
</script>
